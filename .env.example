# AnshuX configuration — copy to .env and adjust for your machine.

# Identity
ANSUX_USER_NAME=Anshu
ANSUX_ASSISTANT_NAME=AnshuX

# Voice models (paths relative to project root)
ANSUX_PIPER_VOICE=voices/en_US-lessac-medium.onnx
ANSUX_WHISPER_MODEL=base.en

# Wake word detection (comma-separated phrases)
ANSUX_WAKE_WORDS=anshux,anshu x,jarvis

# Local AI (Ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# Project folders (Windows paths)
ANSUX_PROJECT_SEMICOLON=C:\Users\Anshu\semicolon
ANSUX_PROJECT_ASTRONOMY=C:\Users\Anshu\astronomy-site
ANSUX_PROJECT_COSMOS=C:\Users\Anshu\cosmos-v2
ANSUX_PROJECT_JARVIS=C:\Users\Anshu\jarvis

# Browser
ANSUX_BRAVE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# HUD dashboard
ANSUX_HUD_PORT=8765
ANSUX_HUD_ENABLED=true
ANSUX_OPEN_HUD_ON_START=true

# Audio tuning
ANSUX_SILENCE_THRESHOLD=150
ANSUX_WAKE_CHUNK_SECONDS=2.5
ANSUX_RECORD_SECONDS=4

# Optional: enable Windows startup (set true to register)
ANSUX_STARTUP_ENABLED=false

# Optional: experimental double-clap wake (requires mic)
ANSUX_CLAP_WAKE_ENABLED=false
