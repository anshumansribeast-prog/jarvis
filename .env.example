# Public URL for the AnshuX dashboard (set this to your live domain)
ANSUX_PUBLIC_URL=https://anshux.punah.pro

# HUD dashboard (internal bind — nginx proxies to this)
ANSUX_HUD_PORT=8765
ANSUX_HUD_HOST=127.0.0.1
ANSUX_HUD_ENABLED=true
ANSUX_OPEN_HUD_ON_START=true

# Leave empty when using a dedicated subdomain. Use /anshux only for subpath hosting.
ANSUX_BASE_PATH=

# Server mode: set HUD_HOST=0.0.0.0 and TEXT_ONLY=true to deploy without nginx
ANSUX_TEXT_ONLY=false
ANSUX_TEXT_CONFIRM_TIMEOUT=90