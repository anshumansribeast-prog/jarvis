# ANSHUX Command Office — production image
FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git \
  && rm -rf /var/lib/apt/lists/*

COPY . /app
RUN python -m venv /app/.venv \
  && /app/.venv/bin/pip install -q -U pip pytest

ENV ANSHUX_OFFICE_HOST=0.0.0.0
ENV ANSHUX_OFFICE_NO_BROWSER=1
ENV ANSHUX_ABHISHEK_EMAIL=abhiis@eleven11.pro

EXPOSE 8765
CMD ["/app/.venv/bin/python", "team.py", "office"]
